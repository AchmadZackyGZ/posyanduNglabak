# ==========================================
# Go Backend (.gitignore)
# ==========================================
# Binari aplikasi (hasil build)
*.exe
*.exe~
*.dll
*.so
*.dylib
# Asumsi nama binari backend Anda adalah 'backend' atau 'main'
backend
main

# Vendor directory (jika menggunakan go mod vendor)
vendor/

# Environment variables
.env
.env.local

# IDE/Editor settings
.vscode/
.idea/
*.swp

# ==========================================
# Svelte / SvelteKit Frontend (.gitignore)
# ==========================================
# Dependencies
node_modules/
.pnpm-debug.log*

# Build output
.svelte-kit/
build/
dist/

# Environment variables
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/Editor settings
.DS_Store
.eslintcache
coverage/
.vercel/

# ==========================================
# Umum / OS
# ==========================================
.DS_Store
Thumbs.db